## main.js

```js
import nodeAssert from "node:assert";
// setup.js
const setup = () => {
	globalThis.foo = "foo";
};
setup();
// read.js
const foo = globalThis.foo;
const read = () => {
	console.log("read", foo);
};
// main.js
setup();
read();
import("./dynamic.js");
nodeAssert.strictEqual(globalThis.foo, "foo");
export { read as t };

```

