# Assets

## dyn.js

```js
import { t as setup } from "./main.js";
// dyn.js
console.log("dyn", typeof setup);

```

## main.js

```js
// setup.js
const setup = () => {
	globalThis.foo = "foo";
};
setup();
// reader.js
const captured = globalThis.foo;
console.log("captured", captured);
// main.js
setup();
import("./dyn.js");
export { setup as t };

```

