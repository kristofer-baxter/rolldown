__withImportOptions({}, () => import("./target.js"), false).then((target) => {
	assert.strictEqual(target.value, 42);
});
const marker = /* @__PURE__ */ new Error("with-getter");
__withImportOptions({ get with() {
	throw marker;
} }, () => import("./target.js"), false).then(() => assert.fail("expected getter rejection"), (err) => assert.strictEqual(err, marker));
const inheritedMarker = /* @__PURE__ */ new Error("inherited-with-getter");
let inheritedRejection;
let explicitEmptyWith;
Object.defineProperty(Object.prototype, "with", {
	configurable: true,
	get() {
		throw inheritedMarker;
	}
});
try {
	inheritedRejection = __withImportOptions({}, () => import("./target.js"), false);
	explicitEmptyWith = import("./target.js");
} finally {
	delete Object.prototype.with;
}
inheritedRejection.then(() => assert.fail("expected inherited getter rejection"), (err) => assert.strictEqual(err, inheritedMarker));
explicitEmptyWith.then((target) => {
	assert.strictEqual(target.value, 42);
});

